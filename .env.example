# Copy to .env before running `docker compose -f infra/docker-compose.yml up`.

POSTGRES_USER=app_migrator
POSTGRES_PASSWORD=change-me-migrator
POSTGRES_DB=seredina
POSTGRES_PORT=5432

REDIS_PORT=6379

# The app_tenant role is created by prisma/rls/policies.sql at migrate time with this
# password -- it's the only role apps/api and apps/worker ever connect as.
APP_TENANT_DB_PASSWORD=change-me-app-tenant

JWT_SECRET=change-me-to-a-long-random-string
# Console session length (default 8h). Deactivating a user or changing their
# role takes effect immediately regardless of this.
# JWT_EXPIRES_IN=8h

# Encrypts every stored secret at rest (AES-256-GCM): email channel passwords and
# Gmail/Microsoft 365 OAuth tokens, SSO client secrets, users' MFA secrets, AI
# provider keys, webhook signing secrets, Telegram bot tokens. MUST be exactly
# 64 hex characters (32 bytes). Generate with: openssl rand -hex 32
# Losing/rotating this key makes all of those undecryptable (mailboxes must be
# reconnected, every user's MFA reset) -- back it up like a database password,
# and never next to the database backups.
ENCRYPTION_KEY=change-me-64-hex-chars-0000000000000000000000000000000000000000

# self_hosted | cloud
SEREDINA_MODE=self_hosted

# Optional. Error tracking (apps/api and apps/worker) -- unset means no-op, no
# account needed for local dev. Points at either Sentry.io or a self-hosted
# GlitchTip instance (protocol-compatible with the Sentry SDK) -- your choice,
# doesn't change any code, just where the DSN's host resolves.
SENTRY_DSN=

# Optional. AI copilot (suggest-reply/summarize on a ticket, and the AI tool
# catalog apps/mcp-server exposes) -- unset means the feature 503s with a clear
# message instead of the API refusing to boot. Three provider choices, pick one
# with AI_PROVIDER ('anthropic' | 'openai' | 'ollama'). Leaving AI_PROVIDER unset
# defaults to 'anthropic' if ANTHROPIC_API_KEY is set, for backward compatibility.
AI_PROVIDER=

# anthropic: get a key at https://console.anthropic.com/. ANTHROPIC_MODEL
# overrides the default (claude-opus-5) for a cheaper/faster model.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# openai: get a key at https://platform.openai.com/. OPENAI_MODEL overrides
# the default (gpt-4.1).
OPENAI_API_KEY=
OPENAI_MODEL=

# ollama: no API key, no per-call cost -- runs against a local Ollama install
# (https://ollama.com) you already have `ollama pull`ed a model into.
# OLLAMA_BASE_URL defaults to http://localhost:11434/v1; OLLAMA_MODEL defaults
# to 'llama3.1' but should match whatever you actually pulled.
OLLAMA_BASE_URL=
OLLAMA_MODEL=

API_PORT=4000

WEB_PORT=8080
# Must match how the browser reaches each service -- both cross the network boundary
# to the user's machine, so neither can be the in-compose-network hostname (`api`/`web`).
# Also read directly by apps/api to build the web app's own public links (e.g. a CSAT
# survey link, docs/adr/0045-csat-surveys.md) -- unset there just means that one
# feature silently no-ops, same "optional, degrades gracefully" posture as SENTRY_DSN.
WEB_ORIGIN=http://localhost:8080
# Empty: the console reaches the API at /api on its own address (the web
# container proxies it), so it works at any domain or IP. Only set this to
# point the console at an API on a different origin.
VITE_API_URL=

# Optional. How often apps/worker polls each active EmailChannel's IMAP inbox, in ms.
EMAIL_POLL_INTERVAL_MS=30000

# Optional. Only used by the profile-gated `mcp-server-http` compose service
# (`docker compose --profile mcp up`) -- see README's "MCP server" section.
MCP_HTTP_PORT=3100

# Optional -- only required to connect a Telegram bot (Settings > Telegram).
# Must be the real, internet-reachable HTTPS base URL agents/customers use to
# reach this API (e.g. https://api.yourcompany.com) -- Telegram calls this
# address directly to deliver messages, so it cannot be localhost or an
# internal compose hostname. See docs/adr/0044-telegram-channel.md.
API_PUBLIC_URL=

# --- Server address and HTTPS (docs/adr/0054-server-address-and-tls.md) ---
# Run scripts/configure-address.sh to fill these in -- it asks for the address
# and how to get a certificate, and sets WEB_ORIGIN / API_PUBLIC_URL to match.
# `proxy` starts the Caddy proxy in front of everything on ports 80/443.
COMPOSE_PROFILES=
# Your domain or IP, e.g. helpdesk.example.com or 192.168.1.20 (http://... when TLS_MODE=off).
SEREDINA_SITE=
# acme (Let's Encrypt) | custom (certs/cert.pem + certs/key.pem) | internal (generated CA) | off
TLS_MODE=
ACME_EMAIL=
HTTP_PORT=80
HTTPS_PORT=443
# CA certificate agents pin for a non-public certificate (set by the script).
TLS_CA_FILE=
# Optional. For devices that can't reach GitHub: an internal web folder with
# a copy of an agent release's files (install.sh, install.ps1, the archives
# and SHA256SUMS from https://github.com/Haphior/seredina-agent/releases).
# The Devices page's install commands then download from here.
AGENT_DOWNLOAD_URL=
# Which host interface the web (8080) and API (4000) ports listen on. The
# script sets 127.0.0.1 once the proxy is in front, so HTTPS is the only way in.
WEB_BIND=0.0.0.0
API_BIND=0.0.0.0
# Postgres and Redis: this machine only. Redis has no password -- don't expose it.
DB_BIND=127.0.0.1

# Updates from the console (docs/adr/0077-in-app-updates.md). Set by
# scripts/enable-updater.sh, which also adds `updater` to COMPOSE_PROFILES;
# leave empty to update by hand.
UPDATER_TOKEN=
# The installation folder on this host (the updater mounts it at that path).
SEREDINA_HOST_DIR=
# Compose files the installation runs with, ':'-separated.
SEREDINA_COMPOSE_FILES=infra/docker-compose.yml
