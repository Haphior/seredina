// Phase 0 added Tenant/User/Role/Permission -- proving tenant isolation (RLS + Prisma)
// end to end. Phase 1 adds the ticketing core below. SLA/custom-fields/AI models land
// in later phases (see docs/ROADMAP.md).
//
// Every tenant-owned table carries an explicit tenant_id column (even join tables,
// denormalized rather than derived via a join) so every RLS policy has the same
// shape: `tenant_id = current_setting('app.tenant_id', true)`. All id/FK columns are
// `@db.Uuid` (native Postgres uuid, not text) -- Prisma's `@default(uuid())` still
// generates the value client-side as a string; Postgres accepts it into a uuid column
// on insert, and this keeps RLS/index comparisons a native uuid=uuid comparison
// instead of relying on a text cast everywhere a policy touches it.
// `Permission` is the one deliberate exception: it's a fixed, global catalog of
// resource:action strings, not tenant data, so it carries no tenant_id and no RLS.

generator client {
  provider        = "prisma-client-js"
  // Needed for the `extensions` datasource block and KbChunk's Unsupported
  // vector column below (Phase 3 RAG, see docs/adr/0032-rag-knowledge-base-search.md).
  previewFeatures = ["postgresqlExtensions", "omitApi"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model Tenant {
  id               String   @id @default(uuid()) @db.Uuid
  slug             String   @unique
  name             String
  mode             String   @default("cloud") // 'self_hosted' | 'cloud'
  lastTicketNumber Int      @default(0) @map("last_ticket_number")
  lastProblemNumber Int     @default(0) @map("last_problem_number")
  branding         Json? // { logoUrl?: string, accentColor?: string } -- see modules/branding; null = no white-label set, Seredina's own look applies
  // Email to customers: language, sender name, company signature, quoting and
  // the survey -- @seredina/shared's EmailSettings; null = the defaults (Spanish).
  // See docs/adr/0070-customer-email-templates.md.
  emailSettings    Json?    @map("email_settings")
  createdAt        DateTime @default(now()) @map("created_at")

  users           User[]
  roles           Role[]
  rolePermissions RolePermission[]
  teams           Team[]
  contacts        Contact[]
  ticketStatuses  TicketStatus[]
  tickets         Ticket[]
  messages        Message[]
  apiKeys         ApiKey[]
  assets          Asset[]
  ticketAssets    TicketAsset[]
  discoveryJobs   DiscoveryJob[]
  devices               Device[]
  deviceEnrollmentTokens DeviceEnrollmentToken[]
  emailChannels   EmailChannel[]
  customFieldDefinitions CustomFieldDefinition[]
  manufacturers   Manufacturer[]
  assetModels     AssetModel[]
  processTemplates      ProcessTemplate[]
  processStepTemplates  ProcessStepTemplate[]
  processInstances      ProcessInstance[]
  processStepInstances  ProcessStepInstance[]
  webhooks              Webhook[]
  macros                Macro[]
  slaPolicies           SlaPolicy[]
  businessHours         BusinessHours?
  dashboardWidgets      DashboardWidget[]
  problems              Problem[]
  serviceCatalogItems   ServiceCatalogItem[]
  services              Service[]
  serviceAssets         ServiceAsset[]
  kbArticles            KbArticle[]
  kbChunks              KbChunk[]
  onCallSchedules       OnCallSchedule[]
  onCallShifts          OnCallShift[]
  escalationTiers       EscalationTier[]
  escalationRuns        EscalationRun[]
  savedViews            SavedView[]
  notifications         Notification[]
  notificationPreferences NotificationPreference[]
  aiUsageLogs           AiUsageLog[]
  attachments           Attachment[]
  autonomyPolicy        AutonomyPolicy?
  aiAgentRuns           AiAgentRun[]
  aiSettings            TenantAiSettings?
  uiSettings            TenantUiSettings?
  kbSettings            TenantKbSettings?
  telegramChannel       TelegramChannel?
  csatResponses         CsatResponse[]
  emailTemplates        EmailTemplate[]
  emailImages           EmailImage[]
  organizations         Organization[]
  directoryContacts     DirectoryContact[]
  contractPayments      ContractPayment[]

  @@map("tenants")
  auditLogs AuditLog[]

  // Every user must set up two-factor sign-in before they can use the console
  // (docs/adr/0061-mfa-totp.md). Off by default; users can still opt in.
  mfaRequired Boolean @default(false) @map("mfa_required")
  ssoSettings TenantSsoSettings?

  // 'off' | 'suggest' | 'auto' -- see docs/adr/0063-ai-triage.md. Off by
  // default: every new ticket costs a model call once it's on.
  aiTriageMode String @default("off") @map("ai_triage_mode")
  contracts      Contract[]
  contractAssets ContractAsset[]
  teamMembers    TeamMember[]
  notificationDefaults TenantNotificationDefault[]

  // First-run setup wizard (docs/adr/0072-first-run-setup.md). Null = not
  // finished yet, so the console offers it; setupTemplate records which
  // starting template was applied, if any.
  setupCompletedAt DateTime? @map("setup_completed_at")
  setupTemplate    String?   @map("setup_template")

  // Customer portal (docs/adr/0065-customer-portal.md): contacts sign in with
  // an emailed link to follow and reply to their own tickets. Off by default.
  customerPortalEnabled Boolean @default(false) @map("customer_portal_enabled")
  // Contacts with no open tickets and no activity for this many days are
  // anonymized automatically by the worker. Null = off (docs/adr/0066-contact-data-rights.md).
  contactRetentionDays Int? @map("contact_retention_days")
}

model Role {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key      String // 'admin' | 'agent' | future custom roles
  name     String

  permissions RolePermission[]
  users       User[]

  @@unique([tenantId, key])
  @@map("roles")
}

model Permission {
  id  String @id @default(uuid()) @db.Uuid
  key String @unique // e.g. 'users:manage' — see packages/shared/src/permissions.ts

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  tenantId     String     @map("tenant_id") @db.Uuid
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleId       String     @map("role_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  name         String
  passwordHash String   @map("password_hash")
  roleId       String?  @map("role_id") @db.Uuid
  role         Role?    @relation(fields: [roleId], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")

  // Null = hasn't seen the guided tour yet -- same "no row/no value = default"
  // shape used elsewhere (TenantAiSettings, DashboardWidget). Set once on
  // finishing or skipping it; the tour can still be replayed manually
  // afterward from the sidebar, which doesn't touch this field.
  tourCompletedAt DateTime? @map("tour_completed_at")

  // Account lockout after repeated failed logins -- see modules/auth/service.ts's
  // login(). failedLoginAttempts resets to 0 on a successful login or once a
  // lockout is applied; lockedUntil null means not currently locked.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")

  // Two-factor sign-in with an authenticator app (TOTP) -- see
  // docs/adr/0061-mfa-totp.md. The secret is encrypted with ENCRYPTION_KEY
  // (the server must recompute codes from it, so it can't be hashed); the
  // pending one exists only between "show QR code" and "confirm first code".
  // mfaLastUsedStep blocks replaying a code inside its validity window.
  // Recovery codes are one-time and high-entropy, so a plain SHA-256 each.
  mfaSecretEncrypted        String?   @map("mfa_secret_encrypted")
  mfaPendingSecretEncrypted String?   @map("mfa_pending_secret_encrypted")
  mfaEnabledAt              DateTime? @map("mfa_enabled_at")
  mfaLastUsedStep           Int?      @map("mfa_last_used_step")
  mfaRecoveryCodeHashes     String[]  @default([]) @map("mfa_recovery_code_hashes")

  // Soft-deactivation for offboarding -- deliberately not a delete: Ticket.assignee
  // and Message.authorUser have no onDelete action (a hard delete would be blocked
  // by Postgres the moment either table has a row referencing this user), and
  // OnCallShift/EscalationTier cascade-delete on User, which would silently erase
  // on-call configuration nobody asked to remove. login() rejects a deactivated
  // user with the same generic 'invalid credentials' error as a locked-out or
  // wrong-password attempt -- same anti-enumeration posture as everywhere else in
  // that function.
  isActive Boolean @default(true) @map("is_active")

  // Sessions issued before this are refused (docs/adr/0067-account-self-service.md):
  // set when the password changes, so a stolen session doesn't outlive it.
  sessionsValidAfter DateTime? @map("sessions_valid_after")
  // Set while an emailed invitation hasn't been accepted yet; cleared when
  // the person chooses their password.
  invitedAt DateTime? @map("invited_at")
  // Closing lines under this agent's replies to customers ("María Pérez\n
  // Mesa de ayuda · anexo 214"); null = just their name.
  emailSignature String? @map("email_signature")

  assignedTickets      Ticket[]              @relation("TicketAssignee")
  authoredMessages     Message[]             @relation("MessageAuthorUser")
  processStepAssignments ProcessStepInstance[]
  dashboardWidgets     DashboardWidget[]
  kbArticles           KbArticle[]
  onCallShifts         OnCallShift[]
  escalationTiers      EscalationTier[]
  acknowledgedEscalations EscalationRun[]
  savedViews           SavedView[]
  notifications        Notification[]
  notificationPreferences NotificationPreference[]
  ownedProblems        Problem[]             @relation("ProblemOwner")
  reviewedAiAgentRuns  AiAgentRun[]
  teamMemberships      TeamMember[]

  @@unique([tenantId, email])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Phase 1: ticketing core
// ---------------------------------------------------------------------------

model Team {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String

  tickets      Ticket[]
  processSteps ProcessStepTemplate[]
  members      TeamMember[]

  @@unique([tenantId, name])
  @@map("teams")
}

// Who belongs to a team -- a plain join table, so a user can be in several
// teams. Drives "a ticket landed in my team" notifications
// (docs/adr/0071-teams-and-notification-events.md).
model TeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teamId    String   @map("team_id") @db.Uuid
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

// The requester on a ticket -- deliberately separate from User (agents/admins), see
// docs/adr/0001-multi-tenancy-rls.md's sibling reasoning for Tenant/User: different
// trust boundary, never merge these into one model even though both have email/name.
model Contact {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email     String
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  // Set when the contact's personal data was erased (docs/adr/0066-contact-data-rights.md):
  // name/email replaced, their tickets' content redacted. Never cleared.
  anonymizedAt DateTime? @map("anonymized_at")

  tickets Ticket[]
  // Equipment handed to this person (docs/adr/0076-directory-payments-inventory.md).
  assignedAssets Asset[] @relation("AssetAssignee")

  @@unique([tenantId, email])
  @@map("contacts")
}

enum TicketStatusCategory {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

// Tenant-defined labels (the "fully configurable" part), each mapped to one of the
// four fixed categories above -- SLA/reporting logic (added in Phase 2) reasons about
// the category, never the label, so a tenant can add as many statuses as they want
// (e.g. "Waiting on Vendor" -> PENDING) without touching that logic.
model TicketStatus {
  id        String               @id @default(uuid()) @db.Uuid
  tenantId  String               @map("tenant_id") @db.Uuid
  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  label     String
  category  TicketStatusCategory
  sortOrder Int                  @default(0) @map("sort_order")

  tickets Ticket[]

  @@unique([tenantId, key])
  @@map("ticket_statuses")
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Ticket {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String         @map("tenant_id") @db.Uuid
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number     Int
  subject    String
  priority   TicketPriority @default(NORMAL)
  statusId   String         @map("status_id") @db.Uuid
  status     TicketStatus   @relation(fields: [statusId], references: [id])
  teamId     String?        @map("team_id") @db.Uuid
  team       Team?          @relation(fields: [teamId], references: [id])
  assigneeId String?        @map("assignee_id") @db.Uuid
  assignee   User?          @relation("TicketAssignee", fields: [assigneeId], references: [id])
  contactId  String         @map("contact_id") @db.Uuid
  contact    Contact        @relation(fields: [contactId], references: [id])
  channel    String         @default("api") // 'api' | 'alert' | 'email' | 'widget' | 'catalog' | 'agent' | 'telegram'
  // The source system's own id for this conversation/problem -- for channel='alert',
  // the monitoring/security tool's own event id (e.g. a Zabbix event id, a Wazuh
  // alert id); for channel='telegram', the Telegram chat id (see
  // docs/adr/0044-telegram-channel.md). Both share the exact same fold-into-the-
  // same-ticket-while-open service-layer dedup (see ingestAlert/handleTelegramUpdate)
  // for the same reason: a re-fired alert or a customer's follow-up message should
  // continue the existing conversation, not spawn a duplicate. Not unique-
  // constrained: "same externalId" is only a duplicate while the earlier ticket is
  // still open -- a closed one legitimately gets a fresh ticket next time.
  externalId String?        @map("external_id")
  // Set only for channel='widget' -- a random bearer token an anonymous
  // website visitor's browser holds (in localStorage, see
  // docs/adr/0040-embeddable-widget.md) to prove it's the same visitor
  // continuing the same conversation, since there's no login for a widget
  // visitor. Unlike externalId this IS unique-constrained: it's a real
  // credential (a guess = read someone else's conversation), not a
  // dedup key where "not unique yet" is a normal, temporary state.
  widgetToken String?       @unique @map("widget_token")
  // Set only for channel='email' -- the mailbox this conversation arrived on,
  // so replies go out from the same address the customer wrote to (not just
  // the tenant's first channel). Null (channel deleted) falls back to the
  // first connected one.
  // AI triage (docs/adr/0063-ai-triage.md): what the model suggested for this
  // ticket -- { priority, teamId, teamName, reason, model, at, applied } -- or
  // null if triage is off, no AI is configured, or it hasn't run yet.
  aiTriage Json? @map("ai_triage")
  emailChannelId String?      @map("email_channel_id") @db.Uuid
  emailChannel   EmailChannel? @relation(fields: [emailChannelId], references: [id], onDelete: SetNull)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  resolvedAt DateTime?      @map("resolved_at")
  closedAt   DateTime?      @map("closed_at")

  // SLA clock, computed from the matching SlaPolicy (by current priority) at
  // creation and recomputed on every priority change -- null when the tenant has
  // no SlaPolicy for that priority, which is how SLA tracking stays fully opt-in.
  // "Met" is resolvedAt (already existed) and firstRespondedAt below; a milestone
  // is breached when its due-at has passed and the matching "met" timestamp is
  // still null. See docs/adr/0011-sla-engine.md.
  // When the current SLA clock started: creation, or the latest priority change
  // (which recomputes both due-ats from that moment). The console's countdown
  // measures "how much of the window is used" against it. Null on tickets from
  // before it existed -- the console falls back to createdAt.
  slaStartedAt       DateTime? @map("sla_started_at")
  firstResponseDueAt DateTime? @map("first_response_due_at")
  firstRespondedAt   DateTime? @map("first_responded_at")
  resolutionDueAt    DateTime? @map("resolution_due_at")

  // Tenant-defined field values, keyed by CustomFieldDefinition.key. jsonb only --
  // no typed mirror table yet (see docs/adr/0006-custom-fields.md for why that's a
  // deliberate v1 scope cut, not an oversight). A key with no matching
  // CustomFieldDefinition row (the definition was since deleted) is simply never
  // rendered -- the value is orphaned but harmless, not cleaned up automatically.
  customFields Json? @map("custom_fields")

  // The root cause this ticket is a symptom of, if one's been identified -- see
  // Problem below and docs/adr/0015-problem-management.md. Nullable + SetNull:
  // a Problem being deleted must never take its linked tickets down with it.
  problemId String?  @map("problem_id") @db.Uuid
  problem   Problem? @relation(fields: [problemId], references: [id], onDelete: SetNull)

  // Set when this ticket was folded into another via mergeTicket() -- see
  // docs/adr/0019-collision-merge-bulk-actions.md. SetNull, not Cascade, so
  // deleting the target later never takes the (already-closed) source down
  // with it -- same reasoning as every other optional self-relation FK here.
  mergedIntoId  String?   @map("merged_into_id") @db.Uuid
  mergedInto    Ticket?   @relation("TicketMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedTickets Ticket[]  @relation("TicketMerge")

  messages        Message[]
  assets          TicketAsset[]
  processSteps    ProcessStepInstance[]
  escalationRuns  EscalationRun[]
  notifications   Notification[]
  aiUsageLogs     AiUsageLog[]
  aiAgentRuns     AiAgentRun[]
  csatResponse    CsatResponse?

  @@unique([tenantId, number])
  @@index([tenantId, channel, externalId])
  // listTickets' default ORDER BY createdAt DESC (tickets/service.ts) had no
  // index covering the sort, only the tenant filter -- Postgres filtered via
  // the (tenantId, channel, externalId) index's leading column, then sorted
  // the matches in memory. Invisible at today's per-tenant ticket volumes
  // (EXPLAIN ANALYZE: 0.09ms at ~100 rows) but the in-memory sort cost grows
  // with each tenant's own ticket count, not the table's total size (RLS
  // already isolates that) -- a B-tree index serves DESC via backward scan,
  // no separate descending index needed.
  @@index([tenantId, createdAt])
  @@map("tickets")
}

enum CustomFieldType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  SELECT
}

// Tenant-defined ticket fields beyond the fixed schema (status/priority/team/...).
// `options` is only meaningful for SELECT (empty otherwise) -- enforced at the
// service layer, not the DB, same trade-off as everywhere else custom-shaped input
// is validated with zod rather than a CHECK constraint.
model CustomFieldDefinition {
  id        String          @id @default(uuid()) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  label     String
  fieldType CustomFieldType @map("field_type")
  options   String[]        @default([])
  required  Boolean         @default(false)
  sortOrder Int             @default(0) @map("sort_order")
  createdAt DateTime        @default(now()) @map("created_at")

  @@unique([tenantId, key])
  @@map("custom_field_definitions")
}

// A tenant-defined "requestable thing" ("new laptop," "VPN access," "onboard a
// contractor") that creates a Ticket pre-filled from the chosen item, via the
// exact same creation path every other channel (api/alert/email) already uses
// -- see docs/adr/0016-service-catalog.md. customFieldKeys references
// CustomFieldDefinition.key (not id) by design, the same "orphaned key is
// harmless" posture Ticket.customFields already takes: a key whose definition
// was since deleted is just never rendered, not a dangling FK to clean up.
model ServiceCatalogItem {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  icon            String?
  customFieldKeys String[] @default([]) @map("custom_field_keys")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([tenantId, name])
  @@map("service_catalog_items")
}

enum MessageAuthorType {
  CONTACT
  AGENT
  SYSTEM
  AI
}

// A ticket's conversation IS its messages -- a public reply and an agent-only
// internal note are both Message rows, differentiated only by isPrivateNote, never
// two separate models.
model Message {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketId      String            @map("ticket_id") @db.Uuid
  ticket        Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType    MessageAuthorType @map("author_type")
  authorUserId  String?           @map("author_user_id") @db.Uuid
  authorUser    User?             @relation("MessageAuthorUser", fields: [authorUserId], references: [id])
  body          String
  isPrivateNote Boolean           @default(false) @map("is_private_note")
  // The email Message-ID header, inbound or outbound, for channel='email' tickets
  // only -- a reply's In-Reply-To/References is matched against this to thread it
  // onto the right ticket. See docs/adr/0004-email-channel.md.
  externalId    String?           @map("external_id")
  // Set on the automatic messages of ticket events (acknowledgement, resolved,
  // closed): { event, subject, body, button? } -- what the worker lays out as
  // the branded email. Null on people's messages. See
  // docs/adr/0070-customer-email-templates.md.
  emailMeta     Json?             @map("email_meta")
  createdAt     DateTime          @default(now()) @map("created_at")

  attachments Attachment[]

  @@index([tenantId, externalId])
  @@map("messages")
}

// File attachments -- manual uploads on a reply/note, and files attached to
// inbound email (docs/adr/0058-inbound-email-attachments.md). Bytes stored directly in Postgres, not an
// object-storage bucket: no MinIO/S3 exists in this stack yet (self-hosted
// Docker Compose has none), and a hard per-file size cap enforced at the
// service layer (modules/attachments/service.ts) keeps row/table bloat bounded
// until real volume justifies standing up object storage instead.
model Attachment {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messageId String   @map("message_id") @db.Uuid
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename  String
  mimeType  String   @map("mime_type")
  sizeBytes Int      @map("size_bytes")
  data      Bytes
  createdAt DateTime @default(now()) @map("created_at")

  @@map("attachments")
}

// Authenticates the API channel (POST /v1/tickets) -- see
// docs/adr/0001-multi-tenancy-rls.md for why resolving "which tenant does this key
// belong to" needs the same SECURITY DEFINER pattern as resolve_tenant_id(slug).
// hashedKey is a plain SHA-256 hex digest, not bcrypt: API keys are high-entropy
// random tokens (unlike passwords), so a fast deterministic hash that supports exact-
// match lookup is correct here, not a slow salted compare.
model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  hashedKey  String    @unique @map("hashed_key")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  @@map("api_keys")
}

// The email channel: inbound polled via IMAP, outbound sent via SMTP -- see
// docs/adr/0004-email-channel.md. Passwords are stored encrypted (AES-256-GCM,
// packages/shared/src/crypto.ts), not hashed like User.passwordHash or ApiKey's
// hashedKey, because the worker needs the real password back to authenticate to the
// mail server -- this is the one place in the schema that needs a genuinely
// recoverable secret, not a one-way or exact-match one.
model EmailChannel {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                  String
  fromAddress           String    @map("from_address")
  imapHost              String    @map("imap_host")
  imapPort              Int       @map("imap_port")
  imapSecure            Boolean   @default(true) @map("imap_secure")
  imapUsername          String    @map("imap_username")
  // Null for an OAuth channel (authType != 'password'), which authenticates
  // with a refreshed access token instead -- see docs/adr/0057-email-oauth.md.
  imapPasswordEncrypted String?   @map("imap_password_encrypted")
  smtpHost              String    @map("smtp_host")
  smtpPort              Int       @map("smtp_port")
  smtpSecure            Boolean   @default(true) @map("smtp_secure")
  smtpUsername          String    @map("smtp_username")
  smtpPasswordEncrypted String?   @map("smtp_password_encrypted")
  isActive              Boolean   @default(true) @map("is_active")
  lastPolledAt          DateTime? @map("last_polled_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  // 'password' | 'google_oauth' | 'microsoft_oauth' (EMAIL_AUTH_TYPES in
  // packages/shared/src/emailOAuth.ts). The OAuth app is the tenant's own
  // (bring-your-own), so its client secret is stored encrypted like a password.
  authType                    String    @default("password") @map("auth_type")
  // 'connected' | 'pending_authorization' | 'needs_reconnect' -- the worker
  // only polls 'connected' channels.
  connectionStatus            String    @default("connected") @map("connection_status")
  lastError                   String?   @map("last_error")
  oauthClientId               String?   @map("oauth_client_id")
  oauthClientSecretEncrypted  String?   @map("oauth_client_secret_encrypted")
  oauthMicrosoftTenant        String?   @map("oauth_microsoft_tenant")
  oauthRefreshTokenEncrypted  String?   @map("oauth_refresh_token_encrypted")
  oauthAccessTokenEncrypted   String?   @map("oauth_access_token_encrypted")
  oauthAccessTokenExpiresAt   DateTime? @map("oauth_access_token_expires_at")

  tickets Ticket[]

  @@map("email_channels")
}

// One row per tenant (unlike EmailChannel, which allows several) -- a tenant
// connects at most one Telegram bot. See docs/adr/0044-telegram-channel.md.
model TelegramChannel {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @unique @map("tenant_id") @db.Uuid
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  botUsername       String   @map("bot_username")
  botTokenEncrypted String   @map("bot_token_encrypted") // AES-256-GCM, same pattern as EmailChannel's passwords
  // Routes an incoming Telegram webhook POST to this tenant before any tenant
  // context exists yet -- resolved via the resolve_tenant_id_by_telegram_webhook
  // SECURITY DEFINER function (same shape as resolve_tenant_id_by_api_key_hash),
  // never guessable-sequential since it's random. webhookSecret is the second,
  // independent check: Telegram echoes it back on every call via the
  // X-Telegram-Bot-Api-Secret-Token header (a documented Bot API feature), so
  // knowing webhookId alone (e.g. from a leaked URL) isn't enough to inject
  // fake messages -- same "why this is safe" reasoning as the widget's token.
  webhookId     String   @unique @map("webhook_id")
  webhookSecret String   @map("webhook_secret")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("telegram_channels")
}

// One row per ticket, created once (the first time a ticket is resolved --
// see docs/adr/0045-csat-surveys.md) and updated in place when the contact
// answers, never recreated on a re-resolve. `token` is a public, unauthenticated
// survey-link credential -- same shape and same reasoning as Ticket.widgetToken.
model CsatResponse {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketId    String    @unique @map("ticket_id") @db.Uuid
  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  token       String    @unique
  rating      Int? // 1-5, null until the contact responds
  comment     String?
  requestedAt DateTime  @default(now()) @map("requested_at")
  respondedAt DateTime? @map("responded_at")

  @@map("csat_responses")
}

// A tenant's own wording for one customer email event (ticket_created,
// agent_reply, ticket_resolved, ticket_closed). No row = the default text in
// the tenant's language from @seredina/shared's emailTemplates.
// See docs/adr/0070-customer-email-templates.md.
model EmailTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event     String
  enabled   Boolean  @default(true)
  subject   String
  body      String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, event])
  @@map("email_templates")
}

// The logo and banner a tenant uploaded for its customer emails, served
// publicly (GET /public/:tenantSlug/email-images/:kind) so mail clients can
// load them. Bytes in Postgres, same reasoning as Attachment: no object
// storage in this stack. See docs/adr/0070-customer-email-templates.md.
model EmailImage {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind      String // 'logo' | 'banner'
  mimeType  String   @map("mime_type")
  data      Bytes
  sha256    String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, kind])
  @@map("email_images")
}

// ---------------------------------------------------------------------------
// CMDB / asset management (agentless discovery) -- see docs/adr/0002-agentless-discovery.md
// ---------------------------------------------------------------------------

// Grouped for the console in packages/shared/src/assetTypes.ts; the later
// values were added for full IT inventory (docs/adr/0076-directory-payments-inventory.md).
enum AssetType {
  SERVER
  WORKSTATION
  NETWORK_DEVICE
  PRINTER
  MOBILE_DEVICE
  OTHER
  LAPTOP
  TABLET
  SWITCH
  ROUTER
  FIREWALL
  ACCESS_POINT
  STORAGE
  UPS
  MONITOR
  PERIPHERAL
  DOCKING_STATION
  SCANNER
  PROJECTOR
  IP_PHONE
  CAMERA
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  RETIRED
}

enum AssetDiscoverySource {
  MANUAL
  AGENTLESS_SCAN
  AGENT
  // Seen in an enrolled agent's ARP/neighbor table -- passive discovery, no
  // scanning (docs/adr/0055-agent-based-discovery.md).
  AGENT_NEIGHBOR
}

// A best-effort seed record from network discovery (see apps/worker/src/discovery),
// not a full fingerprinting engine -- classification is heuristic (SNMP sysDescr
// substring matching), not authoritative. Operators correct/enrich records by hand;
// nothing here blocks that (every field is editable, discoverySource is just
// provenance, not a lock).
model Asset {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  assetType       AssetType            @default(OTHER) @map("asset_type")
  status          AssetStatus          @default(ACTIVE)
  ipAddress       String?              @map("ip_address")
  macAddress      String?              @map("mac_address")
  hostname        String?
  serialNumber    String?              @map("serial_number")
  manufacturer    String?
  model           String?
  operatingSystem String?              @map("operating_system")
  discoverySource AssetDiscoverySource @default(MANUAL) @map("discovery_source")
  snmpSysDescr    String?              @map("snmp_sys_descr")
  // Set only for discoverySource='AGENT' (docs/adr/0047-endpoint-agents-v1.md),
  // the same "source-specific nullable column directly on Asset" shape
  // snmpSysDescr already established above, not a separate inventory table.
  // installedPackages is informational only in v1 -- not paginated or searchable.
  cpuModel          String?  @map("cpu_model")
  memoryTotalMb     Int?     @map("memory_total_mb")
  diskSummary       Json?    @map("disk_summary")
  osVersion         String?  @map("os_version")
  diskEncrypted     Boolean? @map("disk_encrypted")
  antivirusStatus   String?  @map("antivirus_status")
  installedPackages Json?    @map("installed_packages")
  // The agent's full inventory (docs/adr/0069-full-agent-inventory.md):
  // hardware down to memory modules and disk serials, software with
  // publishers, security posture, and for servers their services, ports,
  // roles and guests. One JSON document, replaced on every check-in; the
  // fields people search by (manufacturer, model, serialNumber,
  // operatingSystem) are copied into their columns above. Left out of asset
  // lists (see listAssets): it can be hundreds of kilobytes.
  agentInventory    Json?     @map("agent_inventory")
  agentInventoryAt  DateTime? @map("agent_inventory_at")
  lastSeenAt      DateTime?            @map("last_seen_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  // Optional link into the equipment catalog (docs/adr/0007-equipment-catalog.md).
  // Deliberately separate from the `manufacturer`/`model` free-text columns above,
  // which agentless discovery populates from whatever a device's SNMP sysDescr
  // says -- text that can't be constrained to a curated catalog. This FK is for
  // manually-entered/curated assets only; named `catalogModel` (not `model`) to
  // avoid colliding with the existing free-text column.
  modelId      String?     @map("model_id") @db.Uuid
  catalogModel AssetModel? @relation(fields: [modelId], references: [id])

  // Inventory details, mostly for equipment no agent or scan reports on
  // (monitors, peripherals, network gear) -- docs/adr/0076-directory-payments-inventory.md.
  assetTag          String?       @map("asset_tag")
  location          String?
  // Who uses it: one of the people who write in (an employee).
  assignedContactId String?       @map("assigned_contact_id") @db.Uuid
  assignedContact   Contact?      @relation("AssetAssignee", fields: [assignedContactId], references: [id], onDelete: SetNull)
  // What it's plugged into: a monitor or dock to its computer, a switch to its rack's router.
  parentAssetId     String?       @map("parent_asset_id") @db.Uuid
  parentAsset       Asset?        @relation("AssetConnections", fields: [parentAssetId], references: [id], onDelete: SetNull)
  connectedAssets   Asset[]       @relation("AssetConnections")
  purchaseDate      DateTime?     @map("purchase_date") @db.Date
  purchaseCost      Decimal?      @map("purchase_cost") @db.Decimal(14, 2)
  purchaseCurrency  String?       @map("purchase_currency")
  supplierId        String?       @map("supplier_id") @db.Uuid
  supplier          Organization? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  warrantyEndDate   DateTime?     @map("warranty_end_date") @db.Date
  notes             String?

  tickets  TicketAsset[]
  services ServiceAsset[]
  device   Device?

  // Re-scanning the same range upserts by (tenantId, ipAddress) rather than
  // duplicating -- imperfect under DHCP churn, a known v1 limitation (see ADR), not
  // an oversight. Agent neighbor reports match by MAC first (see
  // modules/devices/neighbors.ts), which is what the macAddress index is for.
  contracts ContractAsset[]

  @@unique([tenantId, ipAddress])
  @@index([tenantId, macAddress])
  @@map("assets")
}

// Phase 5 v1 (docs/adr/0047-endpoint-agents-v1.md) -- inventory-only endpoint
// agents. A short-lived, single-use token that mints a Device's permanent
// credential -- same exact-match-hash shape as ApiKey (sha256Hex, see
// packages/shared/src/crypto.ts), never bcrypt, since this is a high-entropy
// random token, not a user password.
model DeviceEnrollmentToken {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hashedToken String    @unique @map("hashed_token")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("device_enrollment_tokens")
}

// One row per enrolled endpoint. hashedCredential is the device's own permanent
// credential (same shape as ApiKey.hashedKey), minted when a DeviceEnrollmentToken
// is redeemed. assetId is required and unique -- every Device owns exactly one
// Asset, created atomically at enrollment (see modules/devices/service.ts);
// onDelete: Cascade from Asset means deleting the CMDB record removes the
// enrollment with it, while *revoking* (setting revokedAt) is the normal
// compromise-response path -- it leaves the Asset/history alone and just cuts
// off future check-ins for that one device, never every device (the whole point
// of per-device credentials over a shared secret).
model Device {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assetId          String    @unique @map("asset_id") @db.Uuid
  asset            Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  hashedCredential String    @unique @map("hashed_credential")
  platform         String // os.platform() at enrollment: 'linux' | 'darwin' | 'win32'
  agentVersion     String?   @map("agent_version")
  // sha256 of the OS's own stable machine id (/etc/machine-id, Windows
  // MachineGuid, macOS IOPlatformUUID), hashed on the device so the raw id
  // never leaves it. Re-enrolling the same machine reuses its Device+Asset
  // instead of creating a duplicate (docs/adr/0055-agent-based-discovery.md).
  // Nullable: agents older than this send none.
  machineFingerprint String?   @map("machine_fingerprint")
  // The role (server/workstation) the agent last reported. The asset's type
  // follows it only when it changes, so a type an admin set by hand sticks.
  reportedRole     String?   @map("reported_role")
  enrolledAt       DateTime  @default(now()) @map("enrolled_at")
  revokedAt        DateTime? @map("revoked_at")

  @@unique([tenantId, machineFingerprint])
  @@map("devices")
}

// Equipment catalog: a curated reference list, decoupled from Asset instances --
// many assets share one model. Tenant-curated (create one the first time a device
// needs it), not backed by an external device-database API -- no network
// dependency self-hosted operators would otherwise be stuck depending on. See
// docs/adr/0007-equipment-catalog.md.
model Manufacturer {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  models AssetModel[]

  @@unique([tenantId, name])
  @@map("manufacturers")
}

model AssetModel {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  manufacturerId String       @map("manufacturer_id") @db.Uuid
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  name           String
  // Default asset type for a device of this model -- prefills the Asset form's
  // Type field when this model is picked; the asset's own `assetType` stays a
  // plain column the user can still override afterward, never derived live from
  // this at read time.
  assetType      AssetType    @default(OTHER) @map("asset_type")
  createdAt      DateTime     @default(now()) @map("created_at")

  assets Asset[]

  @@unique([tenantId, manufacturerId, name])
  @@map("asset_models")
}

// Lightweight CMDB linkage: "this ticket is about that asset." Deliberately just an
// id pair, no extra metadata (no "relationship type" enum, no notes field) -- add
// that only when a real use case needs it, not preemptively.
model TicketAsset {
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketId String @map("ticket_id") @db.Uuid
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assetId  String @map("asset_id") @db.Uuid
  asset    Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([ticketId, assetId])
  @@map("ticket_assets")
}

// The ITIL "Service Configuration Management" practice: mapping which
// technical Assets actually underpin which business-facing Service ("Email,"
// "Payroll") -- sharper than the general asset-to-asset/asset-to-contact CMDB
// links Asset Management already has. See docs/adr/0017-service-configuration-management.md.
model Service {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  assets ServiceAsset[]

  @@unique([tenantId, name])
  @@map("services")
}

// Many-to-many: one Service can depend on several Assets (e.g. "Email" needs
// both the mail server and the DNS box), and one Asset can underpin several
// Services (a shared database server). Explicit join table with its own
// denormalized tenant_id, same shape as TicketAsset above, for the same RLS
// reason noted at the top of this file.
model ServiceAsset {
  tenantId  String  @map("tenant_id") @db.Uuid
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceId String  @map("service_id") @db.Uuid
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  assetId   String  @map("asset_id") @db.Uuid
  asset     Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([serviceId, assetId])
  @@map("service_assets")
}

// Plain, human-browsable CRUD -- deliberately NOT waiting for Phase 3's pgvector
// RAG plan. "A knowledge base that only an AI can query isn't a knowledge base a
// support team can maintain or trust" (docs/ROADMAP.md) -- embeddings/
// search_knowledge_base land later as a layer ON TOP of these same rows, not the
// reason they exist. See docs/adr/0018-knowledge-base.md. `body` is plain text
// (whitespace-pre-wrap on render), matching Message.body's existing convention --
// no markdown parser anywhere in this codebase yet.
model KbArticle {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title        String
  // Derived from title at creation time (see slugify() in the service layer),
  // not user-editable -- the one stable, URL-safe identifier the public
  // self-service portal links to; the title itself can change freely afterward.
  slug         String
  body         String
  // Drafts are never returned by the public/self-service routes -- only
  // published articles are internet-facing. Unpublished is the default so a
  // half-written article never leaks before someone means it to.
  published    Boolean  @default(false)
  authorUserId String?  @map("author_user_id") @db.Uuid
  author       User?    @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  chunks KbChunk[]

  @@unique([tenantId, slug])
  @@map("kb_articles")
}

// RAG substrate for the AI copilot's knowledge-base grounding (Phase 3 -- see
// docs/adr/0032-rag-knowledge-base-search.md). One row per chunk of a
// KbArticle's body, embedded regardless of `published` -- the copilot drawing
// on a tenant's own agents' internal knowledge is a different trust boundary
// than the public self-service portal (ADR 0018), which independently filters
// on `published` at its own query layer; nothing here is ever exposed to an
// unauthenticated caller.
//
// `embedding` has no first-class Prisma type -- `Unsupported(...)` means every
// write and read of it goes through raw SQL (see modules/kb/embeddings.ts in
// apps/worker and apps/api), never Prisma's normal query API.
model KbChunk {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kbArticleId String    @map("kb_article_id") @db.Uuid
  kbArticle   KbArticle @relation(fields: [kbArticleId], references: [id], onDelete: Cascade)
  content     String
  // 384 dimensions -- Xenova/all-MiniLM-L6-v2 (packages/ai-adapters' LocalEmbeddingAdapter).
  // Changing embedding models/dimensions later means a migration, not just a config flag.
  embedding   Unsupported("vector(384)")?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("kb_chunks")
}

enum DiscoveryJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// One row per triggered scan (apps/worker/src/discovery/processor.ts owns the state
// transitions) -- kept even after completion as an audit trail of what was scanned
// and when, not just a transient job-queue artifact.
model DiscoveryJob {
  id              String             @id @default(uuid()) @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cidrRange       String             @map("cidr_range")
  status          DiscoveryJobStatus @default(PENDING)
  discoveredCount Int                @default(0) @map("discovered_count")
  errorMessage    String?            @map("error_message")
  createdAt       DateTime           @default(now()) @map("created_at")
  startedAt       DateTime?          @map("started_at")
  completedAt     DateTime?          @map("completed_at")

  @@map("discovery_jobs")
}

// IT processes/procedures -- multi-step, multi-person checklists that outlive any
// single conversation (employee onboarding, a commercial document approval chain).
// Deliberately NOT the same model as Macro (a one-shot bundle of actions applied
// instantly to a single ticket) -- see docs/adr/0008-it-processes.md.
//
// `kind` distinguishes Change Enablement and Release Management (ITIL)
// templates from a general process, added rather than separate models -- see
// docs/adr/0013-change-enablement.md for why a Change is "this same engine,
// plus a risk assessment," not a new subsystem. RELEASE follows the same
// reasoning, added in docs/adr/0014-release-management.md: a Release is
// "this same engine, plus a version and an optional link back to the Change
// that approved it."
enum ProcessTemplateKind {
  GENERAL
  CHANGE
  RELEASE
}

model ProcessTemplate {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  kind        ProcessTemplateKind @default(GENERAL)
  createdAt   DateTime            @default(now()) @map("created_at")

  steps     ProcessStepTemplate[]
  instances ProcessInstance[]

  @@unique([tenantId, name])
  @@map("process_templates")
}

model ProcessStepTemplate {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  processTemplateId String          @map("process_template_id") @db.Uuid
  processTemplate   ProcessTemplate @relation(fields: [processTemplateId], references: [id], onDelete: Cascade)
  label             String
  sortOrder         Int             @default(0) @map("sort_order")
  teamId            String?         @map("team_id") @db.Uuid
  team              Team?           @relation(fields: [teamId], references: [id])
  requiresApproval  Boolean         @default(false) @map("requires_approval")

  @@map("process_step_templates")
}

enum ProcessInstanceStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ChangeRiskLevel {
  LOW
  MEDIUM
  HIGH
}

// Spawned from a ProcessTemplate -- its steps are copied into ProcessStepInstance
// rows at creation time (label included), so editing the template later never
// rewrites an already-running instance's history.
model ProcessInstance {
  id                String                @id @default(uuid()) @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Nullable + SET NULL, not the schema default of Cascade for a required
  // relation -- a running or completed instance (e.g. "Jane Doe's onboarding")
  // must survive a template being deleted later; only the back-link to the
  // template is lost, never the instance or its steps.
  processTemplateId String?               @map("process_template_id") @db.Uuid
  processTemplate   ProcessTemplate?      @relation(fields: [processTemplateId], references: [id], onDelete: SetNull)
  // Copied from the template at creation time, same reasoning as step labels --
  // stays readable even after processTemplateId goes null.
  templateName      String                @map("template_name")
  subject           String
  status            ProcessInstanceStatus @default(IN_PROGRESS)
  createdAt         DateTime              @default(now()) @map("created_at")
  completedAt       DateTime?             @map("completed_at")

  // Change Enablement fields -- only ever set when spawned from a
  // ProcessTemplate.kind = CHANGE (enforced at the service layer, not the DB:
  // null for every ordinary process instance). riskLevel is required when
  // starting a Change; plannedStart/plannedEnd/rollbackPlan stay optional --
  // useful, not enforced, for a first pass.
  riskLevel    ChangeRiskLevel? @map("risk_level")
  // plannedStart/plannedEnd/rollbackPlan are shared with Release Management
  // below -- a planned window and a rollback plan are just as meaningful for
  // a deployment as for a change decision, so these three columns aren't
  // Change-exclusive despite living in the block introduced for Change.
  plannedStart DateTime?        @map("planned_start")
  plannedEnd   DateTime?        @map("planned_end")
  rollbackPlan String?          @map("rollback_plan")

  // Release Management fields -- only ever set when spawned from a
  // ProcessTemplate.kind = RELEASE (enforced at the service layer, not the
  // DB). releaseVersion is required when starting a Release, same reasoning
  // as riskLevel for Change: a release with no identified version isn't
  // tracking what's actually being deployed. changeInstanceId is an optional
  // self-relation back to the Change instance that approved this release --
  // "the natural place a Change instance hands off to once approved," per
  // docs/adr/0013-change-enablement.md's Consequences section. SetNull, not
  // the schema default of Cascade for a required relation, because this FK is
  // already nullable -- explicit here anyway, not left to rely on that
  // default, after the onDelete mistake caught in docs/adr/0008-it-processes.md.
  releaseVersion   String?           @map("release_version")
  changeInstanceId String?           @map("change_instance_id") @db.Uuid
  changeInstance   ProcessInstance?  @relation("ReleaseChangeLink", fields: [changeInstanceId], references: [id], onDelete: SetNull)
  releases         ProcessInstance[] @relation("ReleaseChangeLink")

  steps    ProcessStepInstance[]
  // Reverse side of Problem.changeInstanceId below -- the fix a Problem's root
  // cause produced, if any.
  problems Problem[]

  @@map("process_instances")
}

enum ProcessStepStatus {
  PENDING
  DONE
  APPROVED
  REJECTED
  SKIPPED
}

model ProcessStepInstance {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  processInstanceId String          @map("process_instance_id") @db.Uuid
  processInstance   ProcessInstance @relation(fields: [processInstanceId], references: [id], onDelete: Cascade)
  // Copied from the step template at instance-creation time -- see the comment on
  // ProcessInstance above for why. Never re-read from the template afterward.
  label             String
  sortOrder         Int             @default(0) @map("sort_order")
  requiresApproval  Boolean         @default(false) @map("requires_approval")
  status            ProcessStepStatus @default(PENDING)
  assigneeId        String?         @map("assignee_id") @db.Uuid
  assignee          User?           @relation(fields: [assigneeId], references: [id])
  completedAt       DateTime?       @map("completed_at")
  // A step that needs real IT work can link an existing ticket, or the frontend
  // can create one and link it here -- the process stays its own record either
  // way, never shoehorned into the ticket/message model.
  ticketId          String?         @map("ticket_id") @db.Uuid
  ticket            Ticket?         @relation(fields: [ticketId], references: [id])

  @@map("process_step_instances")
}

// Outbound webhooks -- the opposite direction from POST /v1/alerts (something
// notifying Seredina). secretEncrypted follows EmailChannel's precedent: a
// genuinely recoverable secret (needed to HMAC-sign every delivery), AES-256-GCM,
// never a hash. See docs/adr/0009-outbound-webhooks.md.
//
// kind (added docs/adr/0048-chat-notifications.md): 'generic' (default, the
// original shape above) | 'slack' | 'teams'. A chat-kind row posts a plain
// {"text": "..."} message -- the same wire format both platforms' own current
// real webhook mechanisms accept (Slack's Incoming Webhooks, Teams' Workflows
// app) -- to a URL the TENANT generates themselves in their own Slack/Teams
// workspace, no OAuth app or app-review process on this project's side.
// secretEncrypted is nullable because of this: neither platform's webhook has
// an HMAC-signature concept, the URL itself is the only credential.
model Webhook {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind               String    @default("generic")
  url                String
  secretEncrypted    String?   @map("secret_encrypted")
  events             String[]
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  lastDeliveryAt     DateTime? @map("last_delivery_at")
  lastDeliveryStatus String?   @map("last_delivery_status") // 'success' | 'failed'

  @@map("webhooks")
}

// A saved bundle of actions applied to a ticket in one click -- deliberately a
// TYPED action union stored as jsonb (the fixed shape below), never arbitrary
// code, per the original roadmap note. Applying a macro reuses updateTicket/
// addMessage (modules/tickets/service.ts) rather than duplicating their logic,
// which means a macro's effects get webhook dispatch, resolvedAt/closedAt
// stamping, and everything else those functions already do, for free. See
// docs/adr/0010-macros.md.
model Macro {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  actions   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, name])
  @@map("macros")
}

// One row per (tenant, priority) -- deliberately not a general rule-based policy
// engine matching on team/channel/etc. A tenant with no policy for a priority has
// no SLA tracking for tickets at that priority; that's the intended default, not
// a misconfiguration. See docs/adr/0011-sla-engine.md.
model SlaPolicy {
  id                   String         @id @default(uuid()) @db.Uuid
  tenantId             String         @map("tenant_id") @db.Uuid
  tenant               Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  priority             TicketPriority
  firstResponseMinutes Int            @map("first_response_minutes")
  resolutionMinutes    Int            @map("resolution_minutes")
  businessHoursOnly    Boolean        @default(false) @map("business_hours_only")
  createdAt            DateTime       @default(now()) @map("created_at")

  @@unique([tenantId, priority])
  @@map("sla_policies")
}

// At most one per tenant. `schedule` is a fixed-shape jsonb blob (one optional
// array of {start,end} 24h "HH:mm" windows per weekday key mon..sun) -- jsonb here
// isn't for schema flexibility (the shape never varies), it's just less code than
// 14 nullable time columns for the same validated-at-the-boundary data. Only
// consulted when a SlaPolicy has businessHoursOnly=true; a tenant with SLA
// policies but no BusinessHours row gets calendar-time (24/7) due dates for all of
// them. See docs/adr/0011-sla-engine.md for the UTC-offset math and its known
// DST-transition limitation.
model BusinessHours {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timezone  String
  schedule  Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId])
  @@map("business_hours")
}

// Per-USER dashboard preferences, not per-tenant -- two agents at the same
// tenant can hide different widgets or reorder them differently. Only rows
// for a widget the user actually customized exist; a widget type with no row
// shows at its default position/visibility, the same "no row = default" shape
// already used by SlaPolicy. widgetType is validated against a fixed catalog
// at the service layer (zod), not a DB enum, same posture as everywhere else
// a fixed set of string values is checked in this codebase.
model DashboardWidget {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  widgetType String   @map("widget_type")
  sortOrder  Int      @default(0) @map("sort_order")
  visible    Boolean  @default(true)
  // 'normal' | 'wide' (spans both grid columns) -- validated at the service
  // layer against WidgetSize, same "fixed string set, not a DB enum" posture
  // as widgetType above.
  size       String   @default("normal")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, widgetType])
  @@map("dashboard_widgets")
}

// ITIL's own lifecycle for a Problem record: raised while the root cause is
// still unknown, KNOWN_ERROR once it's identified (a workaround may exist even
// before a permanent fix ships), RESOLVED once the fix has landed, CLOSED once
// confirmed stable. Distinct from ProcessInstanceStatus/TicketStatusCategory --
// a Problem's own domain, not reused from either.
enum ProblemStatus {
  UNDER_INVESTIGATION
  KNOWN_ERROR
  RESOLVED
  CLOSED
}

// A Problem is a root cause, not a checklist -- unlike Change/Release
// Management (docs/adr/0013, 0014), it does NOT extend the ProcessInstance
// engine; it's its own small model, exactly as flagged as the plan in
// docs/adr/0014-release-management.md's Consequences section. One Problem can
// explain many Tickets (see Ticket.problemId above); the reverse -- a Ticket
// linked to more than one Problem -- isn't modeled, matching ITIL's own
// "one incident, one root cause" framing. See
// docs/adr/0015-problem-management.md.
model Problem {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number      Int
  title       String
  description String?
  status      ProblemStatus @default(UNDER_INVESTIGATION)
  rootCause   String?       @map("root_cause")
  workaround  String?
  // Optional link to the Change that shipped the permanent fix -- "a real
  // problem management workflow usually produces a change request as its
  // fix" (docs/ROADMAP.md). SetNull, not Cascade, for the same reason as
  // every other optional FK here: the Change being deleted later must never
  // take the Problem record down with it.
  changeInstanceId String?          @map("change_instance_id") @db.Uuid
  changeInstance   ProcessInstance? @relation(fields: [changeInstanceId], references: [id], onDelete: SetNull)
  // The person driving the RCA -- optional (a Problem can sit unowned, same as
  // Ticket.assigneeId), SetNull so a deactivated/deleted user never takes the
  // Problem record down with it.
  ownerId     String?       @map("owner_id") @db.Uuid
  owner       User?         @relation("ProblemOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  resolvedAt  DateTime?     @map("resolved_at")

  tickets Ticket[]

  @@unique([tenantId, number])
  @@map("problems")
}

// "Whoever's on shift right now" -- a named rotation (e.g. "Primary IT
// On-Call") that EscalationTier below can point at instead of a fixed user.
// See docs/adr/0020-oncall-escalation.md.
model OnCallSchedule {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  shifts          OnCallShift[]
  escalationTiers EscalationTier[]

  @@unique([tenantId, name])
  @@map("on_call_schedules")
}

// A block of time one user is on-call for a schedule. Overlapping shifts on the
// same schedule aren't prevented at the DB level (same posture as everywhere
// else a scheduling conflict is a service-layer concern, not a constraint) --
// "who's on shift right now" just picks the first match if more than one
// overlaps.
model OnCallShift {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String         @map("tenant_id") @db.Uuid
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scheduleId String         @map("schedule_id") @db.Uuid
  schedule   OnCallSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  userId     String         @map("user_id") @db.Uuid
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  startsAt   DateTime       @map("starts_at")
  endsAt     DateTime       @map("ends_at")

  @@map("on_call_shifts")
}

// One ordered chain per tenant (like BusinessHours, at most meaningfully one
// "the" chain -- no separate named-policy wrapper for v1). Exactly one of
// userId/onCallScheduleId is set per tier -- who this tier notifies, either a
// fixed person or "whoever's on shift right now." escalateAfterMinutes is how
// long this tier waits for an acknowledgement before the chain moves on (or,
// on the last tier, before giving up) -- meaningful on every tier, including
// the last, not just the ones with a "next."
model EscalationTier {
  id                   String          @id @default(uuid()) @db.Uuid
  tenantId             String          @map("tenant_id") @db.Uuid
  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sortOrder            Int             @default(0) @map("sort_order")
  userId               String?         @map("user_id") @db.Uuid
  user                 User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  onCallScheduleId     String?         @map("on_call_schedule_id") @db.Uuid
  onCallSchedule       OnCallSchedule? @relation(fields: [onCallScheduleId], references: [id], onDelete: Cascade)
  escalateAfterMinutes Int             @map("escalate_after_minutes")

  @@map("escalation_tiers")
}

// ACTIVE until acknowledged (-> ACKNOWLEDGED) or every tier's wait elapses with
// no ack (-> EXHAUSTED, a dead end in v1 -- see ADR).
enum EscalationRunStatus {
  ACTIVE
  ACKNOWLEDGED
  EXHAUSTED
}

// One per SLA breach that actually started an escalation -- "consumes the same
// breach-check delayed-job mechanism already built rather than a second
// scheduler" (docs/ROADMAP.md): apps/worker schedules its own follow-up delayed
// job after notifying each tier, re-checking this row's live state when it
// fires, exactly like apps/worker/src/sla/checkBreach.ts already does for the
// breach check itself.
model EscalationRun {
  id                   String              @id @default(uuid()) @db.Uuid
  tenantId             String              @map("tenant_id") @db.Uuid
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketId             String              @map("ticket_id") @db.Uuid
  ticket               Ticket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  currentTierIndex     Int                 @default(0) @map("current_tier_index")
  status               EscalationRunStatus @default(ACTIVE)
  acknowledgedAt       DateTime?           @map("acknowledged_at")
  acknowledgedByUserId String?             @map("acknowledged_by_user_id") @db.Uuid
  acknowledgedByUser   User?               @relation(fields: [acknowledgedByUserId], references: [id], onDelete: SetNull)
  createdAt            DateTime            @default(now()) @map("created_at")

  @@map("escalation_runs")
}

// "A filter is just serialized query params under a name" (docs/ROADMAP.md).
// Per-agent, not tenant-wide -- like DashboardWidget above, only ever read
// back by the user who created it, never shared. `filters` is a validated
// (at the service layer, zod) subset of ListTicketsFilter -- jsonb rather
// than a column per filter dimension, same posture as Ticket.customFields.
model SavedView {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  filters   Json
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, name])
  @@map("saved_views")
}

// A real Postgres enum, not a validated jsonb string like SavedView.filters --
// this one is referenced from BOTH apps/api and apps/worker (apps/worker never
// imports apps/api code, see docs/adr/0020-oncall-escalation.md), so a
// generated Prisma type both sides get for free is worth more here than the
// open-endedness DashboardWidget.widgetType optimized for.
enum NotificationEventType {
  TICKET_ASSIGNED
  NEW_REPLY
  CONTRACT_EXPIRING
  // docs/adr/0076-directory-payments-inventory.md
  CONTRACT_PAYMENT_DUE
  // docs/adr/0071-teams-and-notification-events.md
  TEAM_TICKET
  SLA_WARNING
  SLA_BREACHED
  MENTIONED
  TICKET_REOPENED
}

// One row per notification actually delivered in-app -- only created when the
// recipient's NotificationPreference (or its default) calls for inApp: true.
// See docs/adr/0022-notifications.md.
model Notification {
  id        String                @id @default(uuid()) @db.Uuid
  tenantId  String                @map("tenant_id") @db.Uuid
  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String                @map("user_id") @db.Uuid
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType NotificationEventType @map("event_type")
  ticketId  String?               @map("ticket_id") @db.Uuid
  ticket    Ticket?               @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  body      String
  readAt    DateTime?             @map("read_at")
  createdAt DateTime              @default(now()) @map("created_at")

  @@map("notifications")
}

// "No row = default" -- same posture as SlaPolicy/DashboardWidget: a user who
// never touched their notification settings has no rows here at all, and the
// service layer resolves inApp: true, email: false for any (userId, eventType)
// pair with no row. Only an explicit change ever creates one.
model NotificationPreference {
  id        String                @id @default(uuid()) @db.Uuid
  tenantId  String                @map("tenant_id") @db.Uuid
  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String                @map("user_id") @db.Uuid
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType NotificationEventType @map("event_type")
  inApp     Boolean               @default(true) @map("in_app")
  email     Boolean               @default(false)

  @@unique([userId, eventType])
  @@map("notification_preferences")
}

// The workspace's own default for an event, set by an admin -- used for anyone
// who hasn't set their own NotificationPreference for it. No row = the built-in
// default (in-app on, email off). See docs/adr/0071-teams-and-notification-events.md.
model TenantNotificationDefault {
  id        String                @id @default(uuid()) @db.Uuid
  tenantId  String                @map("tenant_id") @db.Uuid
  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventType NotificationEventType @map("event_type")
  inApp     Boolean               @default(true) @map("in_app")
  email     Boolean               @default(false)

  @@unique([tenantId, eventType])
  @@map("tenant_notification_defaults")
}

// One row per completed LLM call -- written by the AI copilot's own service
// functions (modules/ai/service.ts) right after adapter.complete() returns,
// never estimated after the fact. `action` is a plain string (like
// DashboardWidget.widgetType), not a DB enum -- Phase 3's autonomous mode
// adds new actions to this same table, not a new one.
// estimatedCostUsd is nullable: an unrecognized model (see
// packages/ai-adapters/src/pricing.ts) logs real token counts with a null
// cost rather than a guessed number. See docs/adr/0023-ai-cost-transparency.md.
model AiUsageLog {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketId         String?  @map("ticket_id") @db.Uuid
  ticket           Ticket?  @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  action           String
  model            String
  inputTokens      Int      @map("input_tokens")
  outputTokens     Int      @map("output_tokens")
  estimatedCostUsd Decimal? @map("estimated_cost_usd") @db.Decimal(10, 6)
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("ai_usage_logs")
}

// ---------------------------------------------------------------------------
// Phase 3: shared AI tool catalog + autonomy policy + audit trail -- see
// docs/adr/0033-ai-tool-catalog-and-autonomy.md. The tool catalog itself
// (apps/api/src/modules/ai-tools/catalog.ts) is plain code, not schema; these
// two models are what let a mutating tool call be either auto-executed or
// held for human approval, and audited either way.
// ---------------------------------------------------------------------------

// One row per tenant (like BusinessHours) -- the tenant-wide configuration of
// which tools an AI agent (the MCP server today; a future autonomous copilot
// loop later) may run without a human clicking approve. A tenant with no row
// gets the safest default: nothing auto-executes (see getAutonomyPolicy() in
// modules/ai-tools/policy.ts) -- "no row = default" is the same shape already
// used for escalation tiers and custom-field sort order.
model AutonomyPolicy {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @unique @map("tenant_id") @db.Uuid
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Tool names (catalog.ts's ToolDefinition.name) allowed to auto-execute --
  // everything else in the catalog still runs, but lands as a
  // PENDING_APPROVAL AiAgentRun instead of executing immediately.
  autoExecuteTools String[] @map("auto_execute_tools")
  maxActionsPerDay Int      @default(20) @map("max_actions_per_day")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("autonomy_policies")
}

enum AiAgentRunStatus {
  PENDING_APPROVAL
  EXECUTED
  REJECTED
  // The tool ran (or was approved to run) but its underlying service call
  // threw -- kept distinct from PENDING_APPROVAL/REJECTED so an approval
  // queue can tell "nobody's looked at this yet" apart from "somebody
  // approved it and it broke."
  FAILED
}

// One row per tool-catalog invocation by any AI actor -- the audit trail the
// roadmap calls for, and (via status) the approval queue for anything the
// AutonomyPolicy didn't allow to auto-execute. `args`/`result` are the exact
// JSON the tool received/returned -- deliberately not redacted, since every
// tool in the catalog is itself just a thin wrapper over the same
// service-layer functions a human agent's own actions already flow through
// (no tool exposes a secret column a normal API response wouldn't).
model AiAgentRun {
  id       String           @id @default(uuid()) @db.Uuid
  tenantId String           @map("tenant_id") @db.Uuid
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketId String?          @map("ticket_id") @db.Uuid
  ticket   Ticket?          @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  toolName String           @map("tool_name")
  args     Json
  result   Json?
  status   AiAgentRunStatus @default(PENDING_APPROVAL)
  // Which caller invoked the tool catalog -- 'mcp' today (apps/mcp-server);
  // a future autonomous copilot loop would add its own value here, reusing
  // this same table rather than a second one, same reasoning as AiUsageLog's
  // `action` column above.
  source     String
  errorMessage String? @map("error_message")

  reviewedByUserId String?   @map("reviewed_by_user_id") @db.Uuid
  reviewedByUser   User?     @relation(fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime? @map("reviewed_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, status])
  @@map("ai_agent_runs")
}

// One row per tenant (same "no row = default" shape as BusinessHours/
// AutonomyPolicy) -- Phase 4's bring-your-own-AI-key: a tenant that never
// configured this uses the deployment-wide AI_PROVIDER/env-var config
// unchanged (see modules/ai/adapter.ts's getAiAdapter). apiKeyEncrypted
// follows the exact same AES-256-GCM pattern as EmailChannel's
// imapPasswordEncrypted/smtpPasswordEncrypted (packages/shared/src/crypto.ts,
// ENCRYPTION_KEY) -- a tenant's own AI provider key is exactly as sensitive
// as their mailbox credentials, never stored any other way. Nullable
// per-field (not one big Json blob) because 'ollama' genuinely needs no key
// at all, and this way a half-configured row (provider set, key not yet
// saved) is representable without a workaround.
model TenantAiSettings {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @unique @map("tenant_id") @db.Uuid
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider        String? // 'anthropic' | 'openai' | 'ollama' -- see AI_PROVIDER's own values
  apiKeyEncrypted String?  @map("api_key_encrypted")
  model           String? // optional override, e.g. a specific model name for the chosen provider
  baseUrl         String?  @map("base_url") // 'ollama' only -- overrides OLLAMA_BASE_URL for this tenant
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("tenant_ai_settings")
}

// "No row = default" shape, same convention as TenantAiSettings above --
// null/missing means the default theme ("middle"), not an error state. See
// docs/adr/0042-tenant-theme-system.md for the actual theming mechanism
// (this table only stores which one a tenant picked).
model TenantUiSettings {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @unique @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  theme     String? // 'middle' | 'refined' -- see UI_THEMES; null means 'middle'
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("tenant_ui_settings")
}

// "No row = default" shape again -- portalEnabled defaults true (matches the
// public KB portal's original, only-ever behavior, so an existing tenant with
// published articles doesn't silently lose its portal on upgrade) and
// hashedAccessCode null means no gate. bcrypt, not sha256 (contrast
// ApiKey.hashedKey) -- this is a short, human-chosen, human-typed passphrase
// shared with real customers, not a high-entropy generated token, so it needs
// a slow hash. See docs/adr/0051-kb-portal-access-control.md.
model TenantKbSettings {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @unique @map("tenant_id") @db.Uuid
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  portalEnabled    Boolean  @default(true) @map("portal_enabled")
  hashedAccessCode String?  @map("hashed_access_code")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("tenant_kb_settings")
}

// Security audit log (docs/adr/0060-audit-log.md): who signed in, who changed
// access, who touched integrations and secrets. Append-only for the app --
// app_tenant is granted SELECT/INSERT only (prisma/rls/policies.sql), so not
// even a compromised API process can rewrite history. actorUserId is a plain
// column, not a relation: the entry must outlive the user it names.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // 'user' | 'system' | 'anonymous'
  actorType   String   @map("actor_type")
  actorUserId String?  @map("actor_user_id") @db.Uuid
  // The actor's email at the time -- still readable after the user is renamed or removed.
  actorLabel  String?  @map("actor_label")
  // Dotted, past tense: 'auth.login_succeeded', 'user.role_changed', ...
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  targetLabel String?  @map("target_label")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([tenantId, action, createdAt])
  @@map("audit_logs")
}

// Single sign-on over OpenID Connect (docs/adr/0062-sso-oidc.md), one per
// tenant. Like the email OAuth app (ADR 0055) the identity-provider app is
// the tenant's own; its client secret is encrypted with ENCRYPTION_KEY.
model TenantSsoSettings {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @unique @map("tenant_id") @db.Uuid
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enabled               Boolean  @default(false)
  // 'microsoft' | 'google' | 'oidc'
  provider              String
  // Microsoft: the directory (tenant) ID; Google: https://accounts.google.com;
  // generic: the issuer URL whose /.well-known/openid-configuration is fetched.
  issuer                String
  clientId              String   @map("client_id")
  clientSecretEncrypted String   @map("client_secret_encrypted")
  // Lowercase email domains allowed to sign in; empty = any the IdP vouches for.
  allowedDomains        String[] @default([]) @map("allowed_domains")
  // Create a console user on first sign-in instead of requiring one to exist.
  autoProvision         Boolean  @default(false) @map("auto_provision")
  defaultRoleKey        String   @default("agent") @map("default_role_key")
  // Password sign-in refused for everyone but admins (the break-glass path).
  enforced              Boolean  @default(false)
  updatedAt             DateTime @updatedAt @map("updated_at")
  createdAt             DateTime @default(now()) @map("created_at")

  @@map("tenant_sso_settings")
}

// Contracts, warranties and licenses tied to assets -- docs/adr/0064-contracts.md.
enum ContractType {
  SUPPORT
  WARRANTY
  LICENSE
  LEASE
  SUBSCRIPTION
  OTHER
}

model Contract {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  type      ContractType @default(SUPPORT)
  supplier  String?
  // Contract or order number, license agreement id -- never a license key
  // itself (that's a secret, and this field is shown in lists and exports).
  reference String?
  startDate DateTime?    @map("start_date") @db.Date
  endDate   DateTime?    @map("end_date") @db.Date
  // Remind this many days before endDate (0 = no reminder).
  renewalNoticeDays Int       @default(30) @map("renewal_notice_days")
  // Set once the reminder went out; cleared whenever endDate changes.
  renewalNotifiedAt DateTime? @map("renewal_notified_at")
  cost          Decimal?   @db.Decimal(14, 2)
  currency      String?
  // 'one_time' | 'monthly' | 'yearly'
  billingPeriod String?    @map("billing_period")
  // Licenses: how many seats/installs the contract covers.
  seats     Int?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // The supplier from the directory, and the person to call there. The
  // free-text `supplier` above stays for contracts entered before the
  // directory existed. docs/adr/0076-directory-payments-inventory.md.
  organizationId String?           @map("organization_id") @db.Uuid
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  contactId      String?           @map("contact_id") @db.Uuid
  contact        DirectoryContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  // Payment schedule: null frequency = no payments tracked. Reminders go out
  // `paymentReminderDays` before `nextPaymentDate`, and once more if it passes
  // unpaid; recording a payment moves the date to the next period. The two
  // *SentFor dates are the due date each reminder was last sent for, so each
  // goes out once per due date.
  paymentFrequency       String?   @map("payment_frequency") // one_time | monthly | bimonthly | quarterly | semiannual | yearly
  nextPaymentDate        DateTime? @map("next_payment_date") @db.Date
  paymentAmount          Decimal?  @map("payment_amount") @db.Decimal(14, 2)
  paymentReminderDays    Int       @default(5) @map("payment_reminder_days")
  paymentReminderEmails  String[]  @default([]) @map("payment_reminder_emails")
  paymentReminderSentFor DateTime? @map("payment_reminder_sent_for") @db.Date
  paymentOverdueSentFor  DateTime? @map("payment_overdue_sent_for") @db.Date

  assets   ContractAsset[]
  payments ContractPayment[]

  @@index([tenantId, endDate])
  @@map("contracts")
}

// A payment made on a contract -- the history behind "next payment due".
model ContractPayment {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contractId String   @map("contract_id") @db.Uuid
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  // The due date this payment settles (null for an extra payment).
  dueDate    DateTime? @map("due_date") @db.Date
  paidOn     DateTime  @map("paid_on") @db.Date
  amount     Decimal?  @db.Decimal(14, 2)
  currency   String?
  reference  String? // invoice or transfer number
  notes      String?
  recordedById String? @map("recorded_by_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([tenantId, contractId, paidOn])
  @@map("contract_payments")
}

enum OrganizationType {
  SUPPLIER
  CUSTOMER
  PARTNER
  INTERNAL
  OTHER
}

// A company in the directory: a supplier, a customer, a partner, an internal
// area. docs/adr/0076-directory-payments-inventory.md.
model Organization {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  type      OrganizationType @default(SUPPLIER)
  taxId     String?          @map("tax_id") // RUT, CUIT, VAT number...
  website   String?
  email     String?
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  contacts  DirectoryContact[]
  contracts Contract[]
  assets    Asset[]

  @@unique([tenantId, name])
  @@map("organizations")
}

enum DirectoryContactRole {
  EXECUTIVE
  MANAGEMENT
  SALES
  TECHNICAL
  SUPPORT
  BILLING
  OTHER
}

// A person in the directory: a supplier's account executive, a partner's
// engineer, a manager. Not the people who write in (Contact): no email is
// required, they don't open tickets, and contact retention never erases
// them. docs/adr/0076-directory-payments-inventory.md.
model DirectoryContact {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organizationId String?              @map("organization_id") @db.Uuid
  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  name           String
  jobTitle       String?              @map("job_title")
  role           DirectoryContactRole @default(OTHER)
  email          String?
  phone          String?
  mobile         String?
  notes          String?
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  contracts Contract[]

  @@index([tenantId, organizationId])
  @@map("directory_contacts")
}

model ContractAsset {
  tenantId   String   @map("tenant_id") @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contractId String   @map("contract_id") @db.Uuid
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  assetId    String   @map("asset_id") @db.Uuid
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([contractId, assetId])
  @@index([assetId])
  @@map("contract_assets")
}
