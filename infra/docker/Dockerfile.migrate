FROM node:22-bookworm-slim AS build
# Prisma's query engine links against OpenSSL, which the slim image lacks;
# without it `prisma generate` picks the wrong engine and queries fail.
RUN apt-get update && apt-get install -y --no-install-recommends openssl \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /repo
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/config/package.json packages/config/package.json
RUN npm ci
COPY packages/config packages/config
COPY packages/shared packages/shared
COPY packages/db packages/db
RUN npm run build --workspace=@seredina/shared && npm run prisma:generate --workspace=@seredina/db

FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends postgresql-client openssl \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /repo
COPY --from=build /repo/node_modules node_modules
COPY --from=build /repo/package.json package.json
COPY --from=build /repo/packages packages
COPY infra/docker/migrate-entrypoint.sh /migrate-entrypoint.sh
RUN chmod +x /migrate-entrypoint.sh
WORKDIR /repo/packages/db
ENTRYPOINT ["/migrate-entrypoint.sh"]
