FROM node:22-bookworm-slim AS build
# Prisma's query engine links against OpenSSL, which the slim image lacks;
# without it `prisma generate` picks the wrong engine and queries fail.
RUN apt-get update && apt-get install -y --no-install-recommends openssl \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /repo
COPY package.json package-lock.json ./
COPY apps/worker/package.json apps/worker/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/ai-adapters/package.json packages/ai-adapters/package.json
RUN npm ci
COPY packages/config packages/config
COPY packages/shared packages/shared
COPY packages/db packages/db
COPY packages/ai-adapters packages/ai-adapters
COPY apps/worker apps/worker
RUN npm run build --workspace=@seredina/shared \
 && npm run prisma:generate --workspace=@seredina/db \
 && npm run build --workspace=@seredina/db \
 && npm run build --workspace=@seredina/ai-adapters \
 && npm run build --workspace=@seredina/worker

FROM node:22-bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends openssl \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /repo
ENV NODE_ENV=production
COPY --from=build /repo/node_modules node_modules
COPY --from=build /repo/package.json package.json
COPY --from=build /repo/apps/worker apps/worker
COPY --from=build /repo/packages packages
WORKDIR /repo/apps/worker
CMD ["node", "dist/index.js"]
